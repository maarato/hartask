# Copy to .env.local and fill in. .env.local is git-ignored; this file is not,
# so it must never hold a real value.

# Where to sync. A libsql:/file: URL is a passive store (Turso); an https: URL
# is another Hartask instance. Leave empty to keep sync off.
HARTASK_SYNC_URL=
# Turso auth token, or the shared secret when syncing with another instance.
HARTASK_SYNC_TOKEN=

# Only on a second machine joining a project that already exists in the store.
# The id is on /settings, and in GET /api/sync as project_uuid.
HARTASK_SYNC_PROJECT_ID=

# Overrides for a single run; see docs/SYNC.md and AGENTS.md.
# HARTASK_DATABASE=
# HARTASK_CONFIG=
# HARTASK_PROJECT_NAME=
# HARTASK_ARCHIVE_REMINDER_THRESHOLD=
